PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_attendance
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ---- Forgot-password OTP ----
DEFAULT_COUNTRY_CODE=91
OTP_EXPIRY_MINUTES=5

# console = prints the OTP in this terminal (development only)
# webhook = calls your workflow API (n8n / Make / Zapier / custom) which sends the SMS
# twilio  = Twilio SMS
SMS_PROVIDER=console

# when SMS_PROVIDER=webhook
WORKFLOW_WEBHOOK_URL=
WORKFLOW_API_KEY=

# when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Face login ----
# true = password AND a live face scan are needed to sign in; admins also scan their face for sensitive actions
FACE_LOGIN_REQUIRED=true
# lower = stricter. 0.5 suits real webcams and room lighting; use 0.45 only if strangers are ever accepted
FACE_LOGIN_THRESHOLD=0.5
# how long one admin face scan unlocks sensitive actions
FACE_PROOF_MINUTES=3
